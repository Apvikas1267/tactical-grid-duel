{
  "name": "tactical-grid-duel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm start --prefix server\" \"npm run dev --prefix client\"",
